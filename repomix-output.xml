                        <YAxis
                            stroke="#94a3b8"
                            tick={{ fill: '#94a3b8', fontSize: 12 }}
                            label={{
                                value: 'Keywords',
                                angle: -90,
                                position: 'insideLeft',
                                style: { fill: '#94a3b8' }
