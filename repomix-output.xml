                    sessions: Number(d.sessions) || 0,
                    conversions: Number(d.conversions) || 0,
                })),
                trafficSources: trafficSources.map(s => ({
                    source: s.source,
                    medium: s.medium,
                    sessions: Number(s.sessions) || 0,
