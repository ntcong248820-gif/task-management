async function addGA4Property() {
    if (!PROPERTY_ID) {
        console.error('❌ Error: Property ID is required');
        console.log('\nUsage: npx tsx scripts/add-ga4-property.ts <PROPERTY_ID> [PROPERTY_NAME]');
