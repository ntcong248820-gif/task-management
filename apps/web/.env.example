# Environment Variables Template
# Copy this file to .env.local and update values

# API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth Redirect URIs (must match Google Cloud Console)
# Better Auth Google login is disabled; these are only for GSC/GA4 integrations.
GOOGLE_GSC_REDIRECT_URI=http://localhost:3002/api/integrations/gsc/callback
GOOGLE_GA4_REDIRECT_URI=http://localhost:3002/api/integrations/ga4/callback

# Better Auth email/password auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3002

# Google Search Console API
# Scopes: https://www.googleapis.com/auth/webmasters.readonly
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly

# Google Analytics 4 API
# Scopes: https://www.googleapis.com/auth/analytics.readonly
GA4_SCOPES=https://www.googleapis.com/auth/analytics.readonly
