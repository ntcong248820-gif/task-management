# ============================================
# TEMPLATE: Copy this to .env.local
# ============================================
# Run: cp .env.local.template .env.local
# Then fill in your actual credentials below


# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001


# ============================================
# Google OAuth 2.0 Credentials
# ============================================
# 📍 Get these from: https://console.cloud.google.com/apis/credentials
# After creating OAuth 2.0 Client ID, you'll see:
# - Client ID: xxxxx.apps.googleusercontent.com
# - Client Secret: xxxxx

# TODO: Replace with your actual Client ID
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com

# TODO: Replace with your actual Client Secret  
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE


# ============================================
# OAuth Redirect URIs
# ============================================
# ⚠️ This MUST match EXACTLY with Google Cloud Console
# Better Auth Google login is disabled for internal MVP.
# These are only for GSC and GA4 integrations.
GOOGLE_GSC_REDIRECT_URI=http://localhost:3002/api/integrations/gsc/callback
GOOGLE_GA4_REDIRECT_URI=http://localhost:3002/api/integrations/ga4/callback

# For production (update when deploying):
# GOOGLE_GSC_REDIRECT_URI=https://yourdomain.com/api/integrations/gsc/callback
# GOOGLE_GA4_REDIRECT_URI=https://yourdomain.com/api/integrations/ga4/callback


# ============================================
# Better Auth Email/Password
# ============================================
BETTER_AUTH_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
BETTER_AUTH_URL=http://localhost:3002


# ============================================
# API Scopes
# ============================================
# Google Search Console - Read-only access
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly

# Google Analytics 4 - Read-only access
GA4_SCOPES=https://www.googleapis.com/auth/analytics.readonly


# ============================================
# 📝 INSTRUCTIONS:
# ============================================
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Find your OAuth 2.0 Client ID
# 3. Copy "Client ID" → Replace YOUR_CLIENT_ID_HERE
# 4. Copy "Client secret" → Replace YOUR_CLIENT_SECRET_HERE
# 5. Save this file as .env.local
# 6. Restart dev server: npm run dev
# ============================================

# ✅ Example (DO NOT USE THESE):
# GOOGLE_CLIENT_ID=123456789-abc123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-abc123def456
